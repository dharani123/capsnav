[Unit]
Description=capsnav mouse motion (Caps+i/j/k/l)
# Needs the X session (DISPLAY), so it runs as a user service.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/capsnav-scroll --mouse
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target

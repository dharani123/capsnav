# capsnav key bindings, shared by [nav] (hold Caps) and [mousemode] (a left
# Shift tap locks them on) in default.conf, which includes this file. Installed next to
# it as /etc/keyd/capsnav-nav (no .conf, so keyd doesn't load it on its own).
# Mouse: i/j/k/l move the pointer (up/left/down/right). The empty layers are
# watched by capsnav-scroll --mouse. g = left button (tap to click, hold and
# move to select text or drag), ; = right click. Buttons stay down while the
# key is held.
i = layer(ijklup)
j = layer(ijklleft)
k = layer(ijkldown)
l = layer(ijklright)
# e/s/d/f: up/left/down/right on the left hand. Whether each cluster (i/j/k/l,
# e/s/d/f) moves the pointer or snaps it to that screen edge depends on the
# pointer mode; x cycles it (both move / e-s-d-f snap / i-j-k-l snap).
e = layer(esdfup)
s = layer(esdfleft)
d = layer(esdfdown)
f = layer(esdfright)
x = layer(pointermode)
g = leftmouse
# Left click on the right hand as well
h = leftmouse
semicolon = rightmouse
# Tabs (browsers, VS Code, terminals): q = previous, w = next,
# t = new tab, y = close tab
q = C-pageup
w = C-pagedown
t = C-t
y = C-w
# Copy / paste, terminal style (Ctrl+Shift+C/V)
c = C-S-c
v = C-S-v
o = end
# VS Code: go to definition, go to symbol in file, go back, go forward
r = f12
a = C-S-o
8 = C-A-minus
9 = C-S-minus
# PrtSc (screenshot). The physical PrtSc key sends KEY_SYSRQ.
7 = sysrq
# Jump pointer + focus to the other monitor (GNOME shortcut -> capsnav-switch-monitor)
p = M-A-o
# Centre the pointer on the current monitor (GNOME shortcut -> capsnav-switch-monitor --center)
u = M-A-u
# Smooth scroll: these layers are watched by capsnav-scroll.py
n = layer(scrollup)
m = layer(scrolldown)
# Caps+Space: i/j/k/l become arrow keys (below)
space = layer(arrows)

# capsnav key bindings for [mousemode] (a Caps tap turns it on) in
# default.conf, which includes this file. Installed next to
# it as /etc/keyd/capsnav-nav (no .conf, so keyd doesn't load it on its own).

# Mouse: i/j/k/l move the pointer (up/left/down/right). The empty layers are
# watched by capsnav-scroll --mouse.
i = layer(ijklup)
j = layer(ijklleft)
k = layer(ijkldown)
l = layer(ijklright)
# e/s/d/f: the same on the left hand. The same direction on both clusters
# (e.g. j + s) moves twice as fast.
e = layer(esdfup)
s = layer(esdfleft)
d = layer(esdfdown)
f = layer(esdfright)
# Controller grip (left hand on the top-left corner): a D-pad, F1 (or Mute)
# = up, ` = left, 1 = down, 2 = right. Same layers as esdf, so the D-pad plus
# the same direction on ijkl moves twice as fast. (F-keys need Fn Lock on.)
f1 = layer(esdfup)
mute = layer(esdfup)
grave = layer(esdfleft)
1 = layer(esdfdown)
2 = layer(esdfright)
# The same on the right: F11 (or End, on the other keyboard) = up, - = left,
# = = down, Backspace = right (ijkl layers, so it adds up with esdf).
f11 = layer(ijklup)
end = layer(ijklup)
minus = layer(ijklleft)
equal = layer(ijkldown)
backspace = layer(ijklright)
# Controller grip: hold Esc (left) or Delete (right) for a 2x pointer, e.g.
# with ` + 1 for a fast diagonal. capsnav-scroll also takes Ctrl, which the HP
# keyboard sends instead of Delete while F11 and Backspace are held.
esc = layer(pointerboost)
delete = layer(pointerboost)
# Clicks: g and h = left button (tap to click, hold and move to select text or
# drag), ; and a = right click. Buttons stay down while the key is held.
g = leftmouse
h = leftmouse
semicolon = rightmouse
a = rightmouse
# Controller grip: Tab or 3 by the left D-pad, 0 or \ on the right = left
# click.
tab = leftmouse
3 = leftmouse
0 = leftmouse
backslash = leftmouse
# Tabs (browsers, VS Code, terminals): q = previous, w = next,
# t = new tab, y = close tab
q = C-pageup
w = C-pagedown
t = C-t
y = C-w
# Backspace on b (same as Caps+b in text mode)
b = backspace
# Lock the screen (GNOME's Super+L)
9 = M-l
# PrtSc (screenshot). The physical PrtSc key sends KEY_SYSRQ.
7 = sysrq
# Jump pointer + focus to the other monitor (GNOME shortcut -> capsnav-switch-monitor):
# u on the right hand, r on the left; F2 or F10 for the controller grip
u = M-A-o
r = M-A-o
f2 = M-A-o
f10 = M-A-o
# Centre the pointer on the current monitor (GNOME shortcut -> capsnav-switch-monitor --center)
p = M-A-u
# Smooth scroll: n/m on the right hand, v/c on the left (up/down). These
# layers are watched by capsnav-scroll.py.
n = layer(scrollup)
m = layer(scrolldown)
c = layer(scrolldown)
v = layer(scrollup)
# Controller grip, right hand: [ = up, ] = down.
leftbrace = layer(scrollup)
rightbrace = layer(scrolldown)
# Space: see [mousemode] in default.conf (window switcher; while scrolling,
# 6x faster scroll via the scroll layers)

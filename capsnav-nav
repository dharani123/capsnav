# capsnav key bindings for [mousemode] (a Caps tap turns it on) in
# default.conf, which includes this file. Installed next to
# it as /etc/keyd/capsnav-nav (no .conf, so keyd doesn't load it on its own).

# Mouse: i/j/k/l move the pointer (up/left/down/right). The empty layers are
# watched by capsnav-scroll --mouse.
i = layer(ijklup)
j = layer(ijklleft)
k = layer(ijkldown)
l = layer(ijklright)
# e/s/d/f: the same on the left hand. The same direction on both clusters
# (e.g. j + s) moves twice as fast.
e = layer(esdfup)
s = layer(esdfleft)
d = layer(esdfdown)
f = layer(esdfright)
# Controller grip (left hand on the top-left corner): a D-pad, F2 (or Volume
# Down) = up, 1 = left, 2 = down, 3 = right. Same layers as esdf, so the D-pad
# plus the same direction on ijkl moves twice as fast. (F-keys need Fn Lock on.)
f2 = layer(esdfup)
volumedown = layer(esdfup)
1 = layer(esdfleft)
2 = layer(esdfdown)
3 = layer(esdfright)
# The same on the right: F11 (or End, on the other keyboard) = up, - = left,
# = = down, Backspace = right (ijkl layers, so it adds up with esdf).
f11 = layer(ijklup)
end = layer(ijklup)
minus = layer(ijklleft)
equal = layer(ijkldown)
backspace = layer(ijklright)
# Controller grip: hold Delete (right) or Esc (left) for a 2x pointer, e.g. with - + = for
# a fast diagonal. capsnav-scroll also takes Ctrl, which the HP keyboard sends
# instead of Delete while F11 and Backspace are held.
delete = layer(pointerboost)
# Esc does the same on the left hand (in keyboard mode it's a plain Esc).
esc = layer(pointerboost)
# `: back to keyboard mode, like a Caps tap (clicks first, so the text
# cursor lands where the pointer is). Caps+` is a real `.
grave = togglem(mousemode, leftmouse)
# Clicks: g and h = left button (tap to click, hold and move to select text or
# drag), ; and a = right click. Buttons stay down while the key is held.
g = leftmouse
h = leftmouse
semicolon = rightmouse
a = rightmouse
# Controller grip: 4 by the left D-pad, 0 or \ on the right = left click.
4 = leftmouse
0 = leftmouse
backslash = leftmouse
# Tabs (browsers, VS Code, terminals): Tab = next, Shift+Tab = previous
# ([mousemode+shift] in default.conf), t = new tab, y = close tab
tab = C-pagedown
t = C-t
y = C-w
# Backspace on b (same as Caps+b in text mode)
b = backspace
# Lock the screen (GNOME's Super+L)
9 = M-l
# PrtSc (screenshot). The physical PrtSc key sends KEY_SYSRQ.
7 = sysrq
# Jump pointer + focus to the other monitor (GNOME shortcut -> capsnav-switch-monitor):
# u on the right hand, r on the left; F3 or F10 for the controller grip
u = M-A-o
r = M-A-o
f3 = M-A-o
f10 = M-A-o
# Volume Up and Home switch too (F3 without Fn Lock; Home on the laptop)
volumeup = M-A-o
home = M-A-o
# Smooth scroll: n/m on the right hand, v/c and w/q on the left (up/down).
# These layers are watched by capsnav-scroll.py.
n = layer(scrollup)
m = layer(scrolldown)
c = layer(scrolldown)
v = layer(scrollup)
q = layer(scrolldown)
w = layer(scrollup)
# Controller grip, right hand: p = up, [ = down.
p = layer(scrollup)
leftbrace = layer(scrolldown)
# Space: see [mousemode] in default.conf (window switcher; while scrolling,
# 6x faster scroll via the scroll layers)

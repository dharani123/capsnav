# capsnav key bindings, shared by [nav] (hold Caps) and [mousemode] (a left
# Shift tap locks them on) in default.conf, which includes this file. Installed next to
# it as /etc/keyd/capsnav-nav (no .conf, so keyd doesn't load it on its own).

# Mouse: i/j/k/l move the pointer (up/left/down/right). The empty layers are
# watched by capsnav-scroll --mouse.
i = layer(ijklup)
j = layer(ijklleft)
k = layer(ijkldown)
l = layer(ijklright)
# e/s/d/f: the same on the left hand. The same direction on both clusters
# (e.g. j + s) moves twice as fast.
e = layer(esdfup)
s = layer(esdfleft)
d = layer(esdfdown)
f = layer(esdfright)
# Pointer mode: x cycles whether each cluster moves the pointer or snaps it to
# that screen edge (both move / e-s-d-f snap / i-j-k-l snap).
x = layer(pointermode)
# Clicks: g and h = left button (tap to click, hold and move to select text or
# drag), ; and a = right click. Buttons stay down while the key is held.
g = leftmouse
h = leftmouse
semicolon = rightmouse
a = rightmouse
# Tabs (browsers, VS Code, terminals): q = previous, w = next,
# t = new tab, y = close tab
q = C-pageup
w = C-pagedown
t = C-t
y = C-w
# Backspace on o, so deleting doesn't mean leaving the home row
o = backspace
# Lock the screen (GNOME's Super+L)
0 = M-l
# PrtSc (screenshot). The physical PrtSc key sends KEY_SYSRQ.
7 = sysrq
# Jump pointer + focus to the other monitor (GNOME shortcut -> capsnav-switch-monitor):
# p on the right hand, r on the left
p = M-A-o
r = M-A-o
# Centre the pointer on the current monitor (GNOME shortcut -> capsnav-switch-monitor --center)
u = M-A-u
# Smooth scroll: n/m on the right hand, c/v on the left (up/down). These
# layers are watched by capsnav-scroll.py.
n = layer(scrollup)
m = layer(scrolldown)
c = layer(scrollup)
v = layer(scrolldown)
# Caps+Space: hold Space for arrow keys on i/j/k/l and fast scrolling on n/m
space = layer(arrows)

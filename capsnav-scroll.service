[Unit]
Description=capsnav smooth scrolling (Caps+n / Caps+m)
# Pointer motion is the same program as a user service: capsnav-mouse.service
After=keyd.service
Wants=keyd.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/capsnav-scroll
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
